{
    "version" : 2,
    "name" : "ScanMyMeal: real time food ordering webapp",
    "builds" : [
        {
            "src" : "./server.js",
            "use" : "@vercel/node"
        }
    ],
    "routes" : [
        {
            "src" : "/(.*)",
            "dest" : "/server.js"
        }
    ]
}
